[TEMPLATE]
# Backend environment — copy to .env and fill in.

# Your Supabase project URL (Project Settings → API → Project URL).
# Only the URL is needed to verify access tokens; no service key belongs here.
SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy/dev only: set this ONLY if your project still signs JWTs with the
# shared secret instead of asymmetric signing keys. New projects use JWKS,
# which needs nothing but SUPABASE_URL. The offline smoke test sets it too.
# SUPABASE_JWT_SECRET=

# Where the frontend normally runs (allowed CORS origins, comma-separated).
CORS_ORIGINS=http://localhost:3000
