[TEMPLATE]
# Frontend environment — copy to .env and fill in.

# API base. Leave as-is in dev: Vite proxies /api to the Flask backend on :5001.
VITE_API_URL=/api

# Supabase Auth (Project Settings → API). Both values are public and ship in
# the bundle by design — never put a service-role key here.
# Google sign-in stays disabled with a setup note until these are set.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
